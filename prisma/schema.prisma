// 관심 단지 알림용 스키마.
// tradeType 등 열거형은 문자열 컬럼으로 두고 허용값을 주석으로 남긴다.

generator client {
  provider = "prisma-client-js"
}

// 환경변수 이름은 Vercel의 Neon 연동이 자동으로 주입하는 것을 그대로 쓴다.
// 값을 복사해 별도 이름으로 두면, Neon이 자격증명을 회전시켰을 때 연동이
// 관리하는 변수만 갱신되고 복사본은 옛날 값으로 남아 조용히 깨진다.
//
//   POSTGRES_PRISMA_URL      pooled + pgbouncer 파라미터. 런타임 쿼리용.
//   POSTGRES_URL_NON_POOLING direct. 마이그레이션은 풀링 위에서 동작하지 않는다.
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

/// 사용자가 등록한 관심 단지 + 매칭 조건
model Watch {
  id             String    @id @default(cuid())
  complexNo      String
  complexName    String
  tradeType      String // "A1" 매매 | "B1" 전세 | "B2" 월세
  areaMinM2      Float? // 전용면적 하한
  areaMaxM2      Float? // 전용면적 상한
  maxPriceManwon Int? // 가격 상한 (만원)
  active         Boolean   @default(true)
  lastCheckedAt  DateTime?
  /// 등록 시점 매물을 "본 것"으로 기록 완료한 시각.
  /// null이면 아직 시딩 전이라, 다음 확인은 알림 없이 시딩으로 처리한다.
  seededAt       DateTime?
  createdAt      DateTime  @default(now())

  seen SeenArticle[]

  // 같은 단지/거래유형을 중복 등록하지 않는다
  @@unique([complexNo, tradeType])
}

/// 이미 확인한 매물. 여기 없는 articleNo만 "신규"로 보고 알림을 보낸다.
model SeenArticle {
  id          String   @id @default(cuid())
  watchId     String
  articleNo   String
  priceManwon Int?
  notifiedAt  DateTime @default(now())

  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([watchId, articleNo])
  @@index([watchId])
}

/// 완료한 웨이트 트레이닝 세션. dayType 값들 사이를 순환하며 다음 세션을 정한다
/// (lib/workout/program.ts의 ROTATION 참고).
model WorkoutSession {
  id          String   @id @default(cuid())
  dayType     String // "A1" | "A2" | "A3" | "B1" | "B2" | "B3"
  completedAt DateTime @default(now())
  note        String?

  @@index([completedAt])
}
