# Postgres (Neon 등). 관심 단지/확인한 매물 저장용.
#
# Neon은 연결 문자열을 두 가지로 준다. 호스트에 "-pooler"가 붙은 pooled와
# 안 붙은 direct다. 용도가 갈리니 둘 다 등록한다.
#
#   DATABASE_URL — pooled. 앱 런타임 쿼리용.
#     서버리스는 요청마다 인스턴스가 뜨므로 풀링이 없으면 커넥션이 고갈된다.
#   DIRECT_URL   — direct. prisma migrate / validate 전용.
#     마이그레이션은 PgBouncer 트랜잭션 풀링 위에서 정상 동작하지 않는다.
#
# 다른 Postgres라 풀러가 따로 없으면 둘에 같은 값을 넣어도 된다.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require"

# 크론 엔드포인트(/api/watches/check) 보호용 공유 시크릿.
# 생성: openssl rand -base64 32
# GitHub Actions secrets에도 같은 값을 CRON_SECRET으로 등록해야 한다.
CRON_SECRET=""

# 텔레그램 봇 알림. @BotFather로 봇을 만들어 토큰을 받고,
# 봇에게 말을 건 뒤 getUpdates로 chat id를 확인한다.
# 둘 중 하나라도 비어 있으면 알림은 조용히 건너뛴다.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
