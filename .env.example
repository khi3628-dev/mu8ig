# Postgres. 관심 단지/확인한 매물 저장용.
#
# 변수 이름은 Vercel의 Neon 연동이 자동으로 주입하는 것을 그대로 쓴다.
# 배포 환경에서는 따로 등록할 게 없고, 자격증명이 회전돼도 자동으로 갱신된다.
#
#   POSTGRES_PRISMA_URL      pooled(호스트에 "-pooler") + pgbouncer 파라미터.
#     앱 런타임 쿼리용. 서버리스는 요청마다 인스턴스가 떠서 풀링이 없으면
#     커넥션이 고갈된다.
#   POSTGRES_URL_NON_POOLING direct("-pooler" 없음). prisma migrate/validate 전용.
#     마이그레이션은 PgBouncer 트랜잭션 풀링 위에서 정상 동작하지 않는다.
#
# 로컬에서 Neon이 아닌 Postgres를 쓴다면 둘에 같은 값을 넣어도 된다.
POSTGRES_PRISMA_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require"

# 크론 엔드포인트(/api/watches/check) 보호용 공유 시크릿.
# 생성: openssl rand -base64 32
# GitHub Actions secrets에도 같은 값을 CRON_SECRET으로 등록해야 한다.
CRON_SECRET=""

# 텔레그램 봇 알림. @BotFather로 봇을 만들어 토큰을 받고,
# 봇에게 말을 건 뒤 getUpdates로 chat id를 확인한다.
# 둘 중 하나라도 비어 있으면 알림은 조용히 건너뛴다.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
