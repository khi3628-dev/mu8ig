# Postgres (Neon 등). 관심 단지/확인한 매물 저장용.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# 크론 엔드포인트(/api/watches/check) 보호용 공유 시크릿.
# 생성: openssl rand -base64 32
# GitHub Actions secrets에도 같은 값을 CRON_SECRET으로 등록해야 한다.
CRON_SECRET=""

# 텔레그램 봇 알림. @BotFather로 봇을 만들어 토큰을 받고,
# 봇에게 말을 건 뒤 getUpdates로 chat id를 확인한다.
# 둘 중 하나라도 비어 있으면 알림은 조용히 건너뛴다.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
